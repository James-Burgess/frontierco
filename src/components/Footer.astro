---
import Glyph from './Glyph.astro';
---

<footer class="footer" transition:animate="slide">
  <div class="footer__top">
    <div class="footer__brand">
      <div class="footer__glyph"><Glyph /></div>
      <p class="footer__tagline">Going where the <span>map runs out</span> — technical training, guided trips and expedition support across Africa.</p>
    </div>
    <div class="footer__stats">
      <div>
        <div class="footer__stat-num">12+</div>
        <div class="footer__stat-label">African countries</div>
      </div>
      <div>
        <div class="footer__stat-num">110m+</div>
        <div class="footer__stat-label">Max operating depth</div>
      </div>
      <div>
        <div class="footer__stat-num">SSI XR / IANTD</div>
        <div class="footer__stat-label">Certified instructors</div>
      </div>
    </div>
  </div>
  <div class="footer__bottom">
    <div class="footer__brand-name">Deep Frontier Diving Co.</div>
    <div class="footer__meta">© 2026 · Dive responsibly. Plan conservatively. · <a href="mailto:ops@deepfrontier.co">ops@deepfrontier.co</a> · <a href="/privacy/">Privacy</a></div>
  </div>
</footer>
