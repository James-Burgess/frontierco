---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Glyph from '../components/Glyph.astro';
import heroSrc from '../assets/img/hero.png';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const heroBg = await getImage({ src: heroSrc, format: 'webp', width: 1920 });
const heroBgImage = [
  'linear-gradient(180deg, rgba(13,24,23,0.55) 0%, rgba(13,24,23,0.3) 48%, var(--ink) 97%)',
  'radial-gradient(120% 90% at 80% 10%, rgba(44,138,110,0.16), transparent 55%)',
  `url('${heroBg.src}')`,
].join(', ');
---

<script>
  import '../scripts/index.ts';
</script>

<BaseLayout
  title="Deep Frontier Diving"
  description="Technical diving, training, guided trips and expedition support across East Africa. SSI XR certified instructors."
  pageCss="/css/index.css"
>
  <Nav activePage="index" />

  <section id="hero" class="hero" style={`background-image: ${heroBgImage};`}>
    <div class="hero__content">
      <div class="hero__tag">Technical Diving · East Africa</div>
      <h1 class="hero__title">Extending the <strong>limit.</strong><br>Into the deep.</h1>
      <p class="hero__sub">
        Technical training, specialised dive trips and full expedition support
        across East Africa: uncharted wrecks, flooded caves, deep reefs and abandoned mines.
      </p>
      <div class="hero__actions">
        <a href="#destinations" class="btn btn--primary">Explore Destinations</a>
        <a href={`${base}expeditions/`} class="btn btn--ghost">Expedition Support</a>
      </div>
    </div>
    <div class="hero__stats">
      <div>
        <div class="hero__stat-num">12+</div>
        <div class="hero__stat-label">African countries</div>
      </div>
      <div>
        <div class="hero__stat-num">110m+</div>
        <div class="hero__stat-label">Max operating depth</div>
      </div>
      <div>
        <div class="hero__stat-num">SSI XR / IANTD</div>
        <div class="hero__stat-label">Certified instructors</div>
      </div>
    </div>
  </section>

  <section id="services" class="section services">
    <div class="section__label">What we offer</div>
    <h2 class="section__title">Precision-planned.<br><strong>Fully supported.</strong></h2>
    <div class="services__grid">
      <div class="services__card">
        <div class="services__card-img" style={`background-image: url('${base}img/training.jpg')`}>
          <div class="services__card-label">01 — Training</div>
        </div>
        <div class="services__card-body">
          <div class="services__card-num">Technical Training</div>
          <div class="services__card-title">Learn to go deeper.</div>
          <div class="services__card-desc">
            SSI XR certified courses taught in small groups — rigorous theory,
            then straight into real technical conditions to apply it.
          </div>
          <ul class="services__card-list">
            <li>Foundational Training</li>
            <li>Decompression Theory</li>
            <li>Extended Range Trimix training</li>
            <li>Wreck &amp; cave specialities</li>
          </ul>
          <a href={`${base}training/`} class="services__card-link">View the SSI XR pathway <span>&rarr;</span></a>
        </div>
      </div>
      <div class="services__card">
        <div class="services__card-img" style={`background-image: url('${base}img/trip.jpg')`}>
          <div class="services__card-label">02 — Guided Trips</div>
        </div>
        <div class="services__card-body">
          <div class="services__card-num">Individual Dive Trips</div>
          <div class="services__card-title">Guided dives in remote water.</div>
          <div class="services__card-desc">
            Small-group guided dives for qualified technical divers, at sites most operators can't reach.
            All logistics handled — travel, gas fills, accommodation.
          </div>
          <ul class="services__card-list">
            <li>Deep wall and reef dives</li>
            <li>Technical Wreck penetration</li>
            <li>Cavern &amp; cave exploration</li>
            <li>Trimix and CCR support</li>
          </ul>
        </div>
      </div>
      <div class="services__card">
        <div class="services__card-img" style="background-image: url('https://images.unsplash.com/photo-1439405326854-014607f694d7?w=800&h=480&fit=crop&q=80')">
          <div class="services__card-label">03 — Expeditions</div>
        </div>
        <div class="services__card-body">
          <div class="services__card-num">Expedition Support</div>
          <div class="services__card-title">Full operational backbone.</div>
          <div class="services__card-desc">
            Everything a scientific, media or private expedition needs to operate,
            from permit acquisition to surface support vessels and decompression stations.
          </div>
          <ul class="services__card-list">
            <li>Permitting &amp; logistics coordination</li>
            <li>Surface support &amp; chase vessels</li>
            <li>Medic &amp; oxygen first aid cover</li>
            <li>Gas blending &amp; fill station setup</li>
          </ul>
          <a href={`${base}expeditions/`} class="services__card-link">Expedition support in full <span>&rarr;</span></a>
        </div>
      </div>
    </div>
  </section>

  <section id="about" class="section about">
    <div class="about__grid">
      <div>
        <div class="section__label">Who we are</div>
        <h2 class="section__title">Built by divers,<br><strong>for the frontier.</strong></h2>
        <p class="lead">
          Deep Frontier Diving was founded by a team of technical divers with extensive
          experience across East African waters. Our focus is on delivering safe,
          meticulously planned dive operations — whether a guided technical trip or
          full logistical support for a large-scale expedition.
        </p>
        <p class="lead">
          We operate with rebreathers, trimix, heliox, and advanced stage diving
          configurations. Every operation is planned, documented, and executed with
          professional rigour.
        </p>
      </div>
      <div class="about__values">
        <div class="about__value">
          <div class="about__value-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <div>
            <div class="about__value-title">Safety First</div>
            <div class="about__value-desc">Thorough dive planning, proper preparation, and contingency protocols on every operation.</div>
          </div>
        </div>
        <div class="about__value">
          <div class="about__value-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          </div>
          <div>
            <div class="about__value-title">Local Expertise</div>
            <div class="about__value-desc">Deep relationships with local operators, port authorities, and communities across East Africa.</div>
          </div>
        </div>
        <div class="about__value">
          <div class="about__value-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
          </div>
          <div>
            <div class="about__value-title">Technical Capability</div>
            <div class="about__value-desc">CCR, OC, trimix, sidemount — we configure for the objective, not the other way around.</div>
          </div>
        </div>
      </div>
    </div>
    <div class="brand-note">
      <div class="brand-note__mark"><Glyph /></div>
      <p class="brand-note__text">Our mark is the <span>cuneiform</span> glyph for the <span>open water</span> — humanity's oldest writing, pressed into clay to record the first ventures beyond the known. We took it as our own: a record of going where the map runs out.</p>
    </div>
  </section>

  <section id="destinations" class="section destinations">
    <div class="destinations__intro">
      <div>
        <div class="section__label">Where we dive</div>
        <h2 class="section__title">Africa's defining<br><strong>dive frontiers.</strong></h2>
      </div>
      <p class="lead">
        Every destination is selected for its technical diving merit —
        depth, visibility, structure, and the challenge it presents.
      </p>
    </div>
    <div class="destinations__grid">
      <div class="destinations__card">
        <div class="destinations__card-img" style="background-image: url('https://images.unsplash.com/photo-1682686581498-5e85c7228119?w=600&h=360&fit=crop&q=80')">
          <div class="destinations__card-code">MOZ · 11°S</div>
        </div>
        <div class="destinations__card-body">
          <div class="destinations__card-name">Mozambique</div>
          <div class="destinations__card-highlight">Quirimbas Archipelago</div>
          <div class="destinations__card-desc">Pristine oceanic walls, deep pinnacles, and Raggie sharks along structures that drop beyond 80m.</div>
        </div>
      </div>
      <div class="destinations__card">
        <div class="destinations__card-img" style="background-image: url('https://images.unsplash.com/photo-1560275619-4662e36fa65c?w=600&h=360&fit=crop&q=80')">
          <div class="destinations__card-code">ZAF · 30°S</div>
        </div>
        <div class="destinations__card-body">
          <div class="destinations__card-name">South Africa</div>
          <div class="destinations__card-highlight">Aliwal Shoal · Sodwana Bay</div>
          <div class="destinations__card-desc">World-class wreck diving, Tiger shark dives, and the Cathedral — a complex technical cave system.</div>
        </div>
      </div>
      <div class="destinations__card">
        <div class="destinations__card-img" style={`background-image: url('${base}img/zim.jpg')`}>
          <div class="destinations__card-code">ZWE · 17°S</div>
        </div>
        <div class="destinations__card-body">
          <div class="destinations__card-name">Zimbabwe</div>
          <div class="destinations__card-highlight">Chinhoyi Caves</div>
          <div class="destinations__card-desc">Vertical limestone shafts, deep cave passages, and unsurveyed leads in some of Africa's least-dived karst.</div>
        </div>
      </div>
      <div class="destinations__card">
        <div class="destinations__card-img" style="background-image: url('https://images.unsplash.com/photo-1552083375-1447ce886485?w=600&h=360&fit=crop&q=80')">
          <div class="destinations__card-code">RWA / COD · 2°S</div>
        </div>
        <div class="destinations__card-body">
          <div class="destinations__card-name">Rwanda / DRC</div>
          <div class="destinations__card-highlight">Lake Kivu</div>
          <div class="destinations__card-desc">High-altitude freshwater diving in a volcanically active rift lake with exceptional visibility.</div>
        </div>
      </div>
      <div class="destinations__card">
        <div class="destinations__card-img" style="background-image: url('https://images.unsplash.com/photo-1530053969600-caed2596d242?w=600&h=360&fit=crop&q=80')">
          <div class="destinations__card-code">NAM · 19°S</div>
        </div>
        <div class="destinations__card-body">
          <div class="destinations__card-name">Namibia</div>
          <div class="destinations__card-highlight">Dragon's Breath · Aigamas</div>
          <div class="destinations__card-desc">Cathedral-scale sinkholes, abseil-access underground lakes, and unsurveyed passages dropping past 140m.</div>
        </div>
      </div>
      <div class="destinations__card">
        <div class="destinations__card-img" style={`background-image: url('${base}img/sudan.jpg')`}>
          <div class="destinations__card-code">SDN · 19°N</div>
        </div>
        <div class="destinations__card-body">
          <div class="destinations__card-name">Sudan</div>
          <div class="destinations__card-highlight">Conshelf II · Sanganeb</div>
          <div class="destinations__card-desc">Diving in Cousteau's footsteps — Conshelf II on the reef, deep wartime wrecks, and southern walls dropping below diveable depths.</div>
        </div>
      </div>
      <a class="destinations__card" id="dest-kenya" href={`${base}kenya/`}>
        <div class="destinations__card-img" style="background-image: url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=600&h=360&fit=crop&q=80')">
          <div class="destinations__card-code">KEN · 2°S</div>
        </div>
        <div class="destinations__card-body">
          <div class="destinations__card-name">Kenya</div>
          <div class="destinations__card-highlight">Lamu · Diani</div>
          <div class="destinations__card-desc">Historic wrecks, coral-encrusted drop-offs, and warm Indian Ocean water year-round.</div>
          <span class="destinations__card-more">Explore Kenya <span>&rarr;</span></span>
        </div>
      </a>
      <a class="destinations__card" id="dest-custom" href={`${base}custom-routes/`}>
        <div class="destinations__card-img" style={`background-image: url('${base}img/custom.jpg')`}>
          <div class="destinations__card-code">MULTI</div>
        </div>
        <div class="destinations__card-body">
          <div class="destinations__card-name">Custom Routes</div>
          <div class="destinations__card-highlight">Build your expedition</div>
          <div class="destinations__card-desc">We plan custom multi-destination expeditions tailored to your objectives, certification level, and timeline.</div>
          <span class="destinations__card-more">Build your route <span>&rarr;</span></span>
        </div>
      </a>
    </div>
  </section>

  <section id="contact" class="section contact">
    <div class="section__label">Get in touch</div>
    <h2 class="section__title">Plan your<br><strong>next descent.</strong></h2>
    <div class="contact__grid">
      <div class="contact__info">
        <p class="lead">
          Tell us what you're planning — a scheduled trip, a private group,
          or an expedition that needs support — and we'll respond within 48 hours.
        </p>
        <div class="contact__item">
          <div class="contact__label">Email</div>
          <div class="contact__value"><a href="mailto:ops@deepfrontier.co">ops@deepfrontier.co</a></div>
        </div>
        <div class="contact__item">
          <div class="contact__label">WhatsApp / Phone</div>
          <div class="contact__value">+49 15678 393836</div>
        </div>
        <div class="contact__item">
          <div class="contact__label">Base of Operations</div>
          <div class="contact__value">Nairobi, Kenya
            <small>Field deployments where needed</small>
          </div>
        </div>
        <div class="contact__item">
          <div class="contact__label">Certifications &amp; Affiliations</div>
          <div class="contact__value">SSI · IANTD · DAN Affiliated</div>
        </div>
      </div>
      <form id="contact-form" class="contact__form" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="dd6bbbb5-b3b0-42fd-a648-180794dcc04d" />
        <input type="hidden" name="subject" value="New Enquiry — Deep Frontier" />
        <input type="hidden" name="redirect" value="false" />
        <input class="contact__input" type="text" name="name" placeholder="Full name" required />
        <input class="contact__input" type="email" name="email" placeholder="Email address" required />
        <select class="contact__select" name="enquiry_type">
          <option value="" disabled selected>Enquiry type</option>
          <option>Guided technical trip</option>
          <option>Expedition support</option>
          <option>Technical training</option>
          <option>Custom itinerary</option>
          <option>General enquiry</option>
        </select>
        <textarea class="contact__textarea" name="message" placeholder="Tell us about your objective, certification level, and preferred dates…"></textarea>
        <button type="submit" class="btn btn--primary">
          Send Enquiry
        </button>
        <p id="form-status" class="contact__status"></p>
      </form>
    </div>
  </section>

  <Footer />
</BaseLayout>
